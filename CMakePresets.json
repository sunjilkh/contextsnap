{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CONTEXTSNAP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (asan+ubsan)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CONTEXTSNAP_ENABLE_SANITIZERS": "ON",
        "CONTEXTSNAP_WARNINGS_AS_ERRORS": "ON",
        "CONTEXTSNAP_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "release-gui",
      "displayName": "Release + Qt GUI",
      "inherits": "release",
      "cacheVariables": {
        "CONTEXTSNAP_BUILD_GUI": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CONTEXTSNAP_WARNINGS_AS_ERRORS": "ON",
        "CONTEXTSNAP_BUILD_BENCHMARKS": "ON",
        "CONTEXTSNAP_LINUX_X11": "ON",
        "CONTEXTSNAP_LINUX_WAYLAND": "ON"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "CI macOS",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CONTEXTSNAP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CONTEXTSNAP_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-gui", "configurePreset": "release-gui" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-macos", "configurePreset": "ci-macos" },
    { "name": "ci-windows", "configurePreset": "ci-windows" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "ci-linux", "inherits": "base", "configurePreset": "ci-linux" },
    { "name": "ci-macos", "inherits": "base", "configurePreset": "ci-macos" },
    { "name": "ci-windows", "inherits": "base", "configurePreset": "ci-windows" }
  ]
}
